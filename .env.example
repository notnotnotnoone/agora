# Copy to .env.local to override. All optional.

# Where flexrouter is running (`flexrouter serve`).
FLEXROUTER_URL=http://localhost:4891

# flexrouter's auth_token or dashboard password, if you set one.
# FLEXROUTER_TOKEN=

# Bucket used to read a dilemma's options. "auto" is flexrouter's best bucket.
# FLEXROUTER_BUCKET=auto

# Where the browser should open flexrouter's dashboard, if not FLEXROUTER_URL.
# FLEXROUTER_DASHBOARD_URL=
